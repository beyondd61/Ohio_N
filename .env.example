# Server Configuration
PORT=3000

# Email IT API Configuration
EMAILIT_API_KEY=your_emailit_api_key_here
EMAILIT_API_URL=https://api.emailit.com/v1

# AI API Configuration (Choose one)
# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 3: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider (openai, claude, or gemini)
AI_PROVIDER=openai

# Sender Email Configuration
SENDER_EMAIL=newsletter@yourdomain.com
SENDER_NAME=Ohio Deals Newsletter

# Newsletter Configuration
NEWSLETTER_NAME=Ohio Local Business Deals

